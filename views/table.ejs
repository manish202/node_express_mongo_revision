    <script src="https://cdn.datatables.net/2.3.8/js/dataTables.js"></script>
    <script>
        $(function(){
            $('#myTable').DataTable({
                ajax: {
                    url: 'https://jsonplaceholder.typicode.com/posts',
                    dataSrc: ''
                },
                columns: [
                    {data:'id'},
                    {data:'title'},
                    {data:'body'},
                ]
            } );
        });
    </script>
</body>
