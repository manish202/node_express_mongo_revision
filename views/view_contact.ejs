<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <%- include('partials/headtag') -%>
</head>
<body>
    <div class="container my-3">
        <div class="row shadow rounded p-3 text-bg-light">
            <div class="col-md-6"><h2>Contact Details</h2></div>
            <div class="col-md-6 text-end">
                <a href="/" class="btn btn-lg btn-dark">Go Home</a>
            </div>
        </div>
        <div class="row my-3 rounded text-bg-light">
            <div class="col-md-8 py-2 mx-auto">
                <form action="#" method="POST">
                    <div class="mb-3">
                        <label class="form-label">First Name</label>
                        <input type="text" class="form-control" name="fname" placeholder="First Name" value="<%= contact.fname %>" readonly>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Last Name</label>
                        <input type="text" class="form-control" name="lname" placeholder="Last Name" value="<%= contact.lname %>" readonly>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" name="email" placeholder="hello@mail.com" value="<%= contact.email %>" readonly>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Phone</label>
                        <input type="number" class="form-control" name="phone" placeholder="Phone" value="<%= contact.phone %>" readonly>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Address</label>
                        <textarea class="form-control" name="address" placeholder="Address" rows="3" readonly><%= contact.address %></textarea>
                    </div>
                    <div class="mb-3">
                        <a href="/edit-contact/<%= contact.id %>" class="btn btn-primary">Edit</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>